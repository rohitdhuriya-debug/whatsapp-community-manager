# ---------------------------------------------------------------------------
# WhatsApp Community Manager - environment
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# OpenRouter API key - create a free key at https://openrouter.ai/keys
# Only models whose id ends in ":free" are ever called.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Any random string you invent. Protects your local WAHA container.
# Both the app and the WAHA container read this same value.
WAHA_API_KEY=change-me-to-a-long-random-string

# Login for the WAHA QR dashboard at http://localhost:3000/dashboard.
# Pin these - otherwise WAHA invents a new random password on every restart.
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=change-me-too

# ---------------------------------------------------------------------------
# Everything below has sane defaults - only change if you know why.
# ---------------------------------------------------------------------------

# Where WAHA is reachable from the app (loopback only - see HC-3)
WAHA_BASE_URL=http://127.0.0.1:3000

# WAHA Core free tier allows exactly ONE session and it must be named "default"
WAHA_SESSION=default

# Dashboard bind address / port. Keep the bind on loopback even when using a
# tunnel - cloudflared connects locally, so nothing needs to listen publicly.
APP_HOST=127.0.0.1
APP_PORT=8080

# Set to your tunnel address when running one, e.g.
#   PUBLIC_URL=https://something.trycloudflare.com
# Used for absolute links, most importantly the Google Drive OAuth redirect.
PUBLIC_URL=

# All cron schedules run in this timezone
TIMEZONE=Asia/Kolkata

# Default OpenRouter model - MUST end with ":free"
DEFAULT_MODEL=google/gemma-4-26b-a4b-it:free

# Optional bearer token for the dashboard API. Empty = disabled (default).
# Single-user local app, so this is off unless you want it.
APP_BEARER_TOKEN=
